# Local Windows development (no PostgreSQL/Redis services required).
SECRET_KEY=replace-with-a-generated-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DB_ENGINE=sqlite
SQLITE_NAME=db.local.sqlite3

# Optional PostgreSQL; required for Docker. Use your own credentials.
POSTGRES_DB=django_academy
POSTGRES_USER=django_academy
POSTGRES_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Empty Redis URL selects development-only process-local caching.
REDIS_URL=
# Eager tasks run synchronously without a broker or worker.
CELERY_TASK_ALWAYS_EAGER=True
CELERY_BROKER_URL=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
